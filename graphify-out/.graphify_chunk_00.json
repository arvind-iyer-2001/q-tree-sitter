    },
    {
      "id": "wave_3_packaging",
      "label": "Wave 3: Packaging and Integration",
      "file_type": "rationale",
      "source_file": ".superpowers/sdd/progress.md",
      "rationale": "Tasks 11-13 build Python wheel, verify language() loads, and integrate with Graphify for extraction."
    },
    {
      "id": "tree_sitter_grammar_architecture",
      "label": "Tree-sitter Modular Grammar Architecture",
      "file_type": "rationale",
      "source_file": ".superpowers/sdd/task-1-brief.md",
      "rationale": "Grammar split into modules (literals, identifiers, functions, expression, qsql, control, commands) merged via Object.assign(). Each module independently testable, each wave-1 task owns one module."
    },
    {
      "id": "expression_rtl_design",
      "label": "Right-to-Left (RTL) Expression Model",
      "file_type": "rationale",
      "source_file": ".superpowers/sdd/task-6-brief.md",
      "rationale": "q has no operator precedence; every dyadic operation binds right. Implemented as right-recursive binary fold: binary = prec.right(seq(left:_application, operator, right:_expression)). Ensures 2*3+4 parses right-nested."
    },
    {
      "id": "glr_conflict_strategy",
      "label": "GLR Conflict Resolution Strategy",
      "file_type": "rationale",
      "source_file": ".superpowers/sdd/task-6-report.md",
      "rationale": "Four conflicts intentionally kept: symbol_vector/_primary (single vs repeat), call/index (q resolves at eval), call/_application (juxtaposition), builtin/select (keyword reuse). Others removed via prec/structure. Task 10 reconciles across all branches."
    },
    {
      "id": "external_scanner_tokens",
      "label": "External Scanner Token Set",
      "file_type": "rationale",
      "source_file": ".superpowers/sdd/task-2-brief.md",
      "rationale": "Seven external tokens: COMMENT (line/block), SYSTEM_COMMAND_TOK (backslash), NEG_NUMBER (whitespace-sensitive), LIST_WS (vector separator), ADVERB_TOK (postfix iterator), EOS (statement terminator), ERROR_SENTINEL."
    },
    {
      "id": "node_taxonomy",
      "label": "Frozen Node Type Taxonomy",
      "file_type": "rationale",
      "source_file": ".superpowers/sdd/task-1-report.md",
      "rationale": "Complete rule-name set frozen after Task 1: assignment, lambda, parameters, call, index, binary, adverb_apply, select_statement, control, cond, plus 20+ literal types. All downstream tasks reference these names."
    },
    {
      "id": "namespace_qualification",
      "label": "Namespace Qualification (\\d)",
      "file_type": "rationale",
      "source_file": ".superpowers/sdd/task-2-report.md",
      "rationale": "Scanner emits SYSTEM_COMMAND_TOK for backslash commands; parser defers \\d to namespace_directive rule. Namespace state tracked by Graphify extractor for function/variable scoping."
    },
    {
      "id": "computed_column_syntax",
      "label": "q-SQL Computed Column Syntax",
      "file_type": "rationale",
      "source_file": ".superpowers/sdd/task-7-report.md",
      "rationale": "Phrases inside select/exec/update/delete clauses are `;`-separated expressions. To support col:expr naming, _expression is overridden in qsql.js to include assignment, allowing column-def within phrase context."
    },
    {
      "id": "cache_clash_concern",
      "label": "macOS Tree-sitter Dylib Cache Clash",
      "file_type": "rationale",
      "source_file": ".superpowers/sdd/progress.md",
      "rationale": "Grammar name 'q' shared across worktrees caches ~.../Library/Caches/tree-sitter/lib/q.dylib. Always use tree-sitter test --rebuild in worktrees; prevents stale binary loading."
    },
    {
      "id": "graphify_extractor_contract",
      "label": "Graphify Extractor Contract",
      "file_type": "rationale",
      "source_file": ".superpowers/sdd/task-12-brief.md",
      "rationale": "Extractor returns {nodes:[{id, name, kind, line}], edges:[{src, dst, relation, line, confidence}]}. Kinds: file, function, variable. Relations: contains, calls, imports, uses. Namespace-aware via \\d tracking."
    },
