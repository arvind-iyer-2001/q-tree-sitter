      "id": "wave_1_parallel",
      "label": "Wave 1: Parallel Grammar Tasks",
      "file_type": "rationale",
      "source_file": ".superpowers/sdd/progress.md",
      "rationale": "Tasks 2-9 run in parallel worktrees after Task 1 foundation completes. Each owns a grammar module and implements corresponding test corpus."
    },
    {
      "id": "wave_2_convergence",
      "label": "Wave 2: Convergence and Merge",
      "file_type": "rationale",
      "source_file": ".superpowers/sdd/progress.md",
