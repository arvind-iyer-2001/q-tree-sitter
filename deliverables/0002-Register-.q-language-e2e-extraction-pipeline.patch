+
+# ---------------------------------------------------------------------------
+# T14/T15 — registration + end-to-end pipeline
+# ---------------------------------------------------------------------------
+
+GOLDEN_Q = (
+    "\\d .app\n"
+    "\\l util.q\n"
+    "trades:([]sym:`a`b;price:1 2)\n"
+    "add:{[a;b]a+b}\n"
+    "main:{r:add[1;2]; select from trades}\n"
+    "\\d .\n"
+)
+
+
+def test_dispatch_routes_q_to_extractor(tmp_path: Path) -> None:
+    """A .q path must resolve to extract_q through graphify's real dispatch."""
+    from graphify.extract import _get_extractor
+    f = tmp_path / "m.q"
+    f.write_text("a:{1+1}\n")
+    extractor = _get_extractor(f)
+    assert extractor is not None, ".q did not resolve to an extractor"
+    assert extractor.__name__ == "extract_q"
+
+
+def test_q_in_code_extensions_and_registry() -> None:
+    """.q is registered for detection, watching, and the extractor registry."""
+    from graphify.detect import CODE_EXTENSIONS
+    from graphify.extractors import LANGUAGE_EXTRACTORS
+    assert ".q" in CODE_EXTENSIONS
+    assert LANGUAGE_EXTRACTORS.get("q").__name__ == "extract_q"
+
+
+def test_e2e_golden_through_dispatch(tmp_path: Path) -> None:
+    """End-to-end: a golden .q file, routed through dispatch, yields the full
+    set of node/edge kinds graphify expects from q — functions, a call, a
+    namespace-qualified name, an import, and a table use — and validates."""
+    from graphify.extract import _get_extractor
+    from graphify.validate import validate_extraction
+
+    f = tmp_path / "golden.q"
+    f.write_text(GOLDEN_Q)
+
+    out = _get_extractor(f)(f)
+    assert validate_extraction(out) == [], "golden .q failed schema validation"
+
+    names = _names(out)
+    # functions (namespace-qualified via \d .app)
+    assert ".app.add" in names, names
+    assert ".app.main" in names, names
+    # import edge to util (\l util.q)
+    assert "util" in {dst for _, dst in _imports(out)}, _imports(out)
+    # call edge main -> add
+    assert any(s.endswith("main") and d.endswith("add") for s, d in _calls(out)), _calls(out)
+    # table use: trades referenced via select; trades must appear as a node
+    assert "trades" in names or ".app.trades" in names, names
+    uses = [e for e in out["edges"] if e["relation"] == "uses"]
+    assert uses, "expected a 'uses' edge from select ... from trades"
