{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "q",
  "word": "identifier",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "_statement"
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_eos"
              },
              {
                "type": "BLANK"
              }
            ]
          }
        ]
      }
    },
    "_statement": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "assignment"
        },
        {
          "type": "SYMBOL",
          "name": "system_command"
        },
        {
          "type": "SYMBOL",
          "name": "_expression"
        }
      ]
    },
    "number": {
      "type": "PATTERN",
      "value": "[0-9]+"
    },
    "boolean": {
      "type": "PATTERN",
      "value": "[01]+b"
    },
    "byte": {
      "type": "PATTERN",
      "value": "0x[0-9a-fA-F]+"
    },
    "string": {
      "type": "PATTERN",
      "value": "\"[^\"]*\""
    },
    "char": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "\""
        },
        {
          "type": "PATTERN",
          "value": "."
        },
        {
          "type": "STRING",
          "value": "\""
        }
      ]
    },
    "symbol": {
      "type": "PATTERN",
      "value": "`[A-Za-z0-9._:]*"
    },
    "vector": {
      "type": "PREC_LEFT",
      "value": 0,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "number"
          },
          {
            "type": "REPEAT1",
            "content": {
              "type": "SEQ",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "_list_ws"
                },
                {
                  "type": "SYMBOL",
                  "name": "number"
                }
              ]
            }
          }
        ]
      }
    },
    "null": {
      "type": "STRING",
      "value": "0N"
    },
    "infinity": {
      "type": "STRING",
      "value": "0W"
    },
    "timestamp": {
      "type": "PATTERN",
      "value": "[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}D[0-9:.]+"
    },
    "date": {
      "type": "PATTERN",
      "value": "[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}"
    },
    "month": {
      "type": "PATTERN",
      "value": "[0-9]{4}\\.[0-9]{2}m"
    },
    "time": {
      "type": "PATTERN",
      "value": "[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}"
    },
    "minute": {
      "type": "PATTERN",
      "value": "[0-9]{2}:[0-9]{2}"
    },
    "second": {
      "type": "PATTERN",
      "value": "[0-9]{2}:[0-9]{2}:[0-9]{2}"
    },
    "timespan": {
      "type": "PATTERN",
      "value": "[0-9]+D[0-9:.]+"
    },
    "datetime": {
      "type": "PATTERN",
      "value": "[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}T[0-9:.]+"
    },
    "identifier": {
      "type": "PATTERN",
      "value": "[A-Za-z][A-Za-z0-9_]*"
    },
    "dotted_name": {
      "type": "PATTERN",
      "value": "\\.[A-Za-z][A-Za-z0-9_.]*"
    },
    "builtin": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "select"
        },
        {
          "type": "STRING",
          "value": "from"
        },
        {
          "type": "STRING",
          "value": "where"
        },
        {
          "type": "STRING",
          "value": "by"
        }
      ]
    },
    "symbol_vector": {
      "type": "PREC_LEFT",
      "value": 0,
      "content": {
        "type": "REPEAT1",
        "content": {
          "type": "SYMBOL",
          "name": "symbol"
        }
      }
    },
    "assignment": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "FIELD",
            "name": "left",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "identifier"
                },
                {
                  "type": "SYMBOL",
                  "name": "dotted_name"
                }
              ]
            }
          },
          {
            "type": "FIELD",
            "name": "operator",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "STRING",
                  "value": "::"
                },
                {
                  "type": "STRING",
                  "value": ":"
                }
              ]
            }
          },
          {
            "type": "FIELD",
            "name": "right",
            "content": {
              "type": "SYMBOL",
              "name": "_expression"
            }
          }
        ]
      }
    },
    "lambda": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "parameters",
              "content": {
                "type": "SYMBOL",
                "name": "parameters"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "FIELD",
          "name": "body",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_lambda_body"
              },
              {
                "type": "BLANK"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "_lambda_body": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_statement"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": ";"
              },
              {
                "type": "SYMBOL",
                "name": "_statement"
              }
            ]
          }
        }
      ]
    },
    "parameters": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "FIELD",
                  "name": "param",
                  "content": {
                    "type": "SYMBOL",
                    "name": "param"
                  }
                },
                {
                  "type": "REPEAT",
                  "content": {
                    "type": "SEQ",
                    "members": [
                      {
                        "type": "STRING",
                        "value": ";"
                      },
                      {
                        "type": "FIELD",
                        "name": "param",
                        "content": {
                          "type": "SYMBOL",
                          "name": "param"
                        }
                      }
                    ]
                  }
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "]"
        }
      ]
    },
    "param": {
      "type": "SYMBOL",
      "name": "identifier"
    },
    "_expression": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "binary_expression"
        },
        {
          "type": "SYMBOL",
          "name": "call"
        },
        {
          "type": "SYMBOL",
          "name": "lambda"
        },
        {
          "type": "SYMBOL",
          "name": "parenthesized"
        },
        {
          "type": "SYMBOL",
          "name": "list"
        },
        {
          "type": "SYMBOL",
          "name": "cond"
        },
        {
          "type": "SYMBOL",
          "name": "_literal_ref"
        }
      ]
    },
    "_literal_ref": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "number"
        },
        {
          "type": "SYMBOL",
          "name": "string"
        },
        {
          "type": "SYMBOL",
          "name": "symbol"
        },
        {
          "type": "SYMBOL",
          "name": "identifier"
        },
        {
          "type": "SYMBOL",
          "name": "dotted_name"
        }
      ]
    },
    "_noun": {
      "type": "SYMBOL",
      "name": "_literal_ref"
    },
    "binary_expression": {
      "type": "PREC_LEFT",
      "value": 1,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "FIELD",
            "name": "left",
            "content": {
              "type": "SYMBOL",
              "name": "_expression"
            }
          },
          {
            "type": "FIELD",
            "name": "operator",
            "content": {
              "type": "SYMBOL",
              "name": "operator"
            }
          },
          {
            "type": "FIELD",
            "name": "right",
            "content": {
              "type": "SYMBOL",
              "name": "_expression"
            }
          }
        ]
      }
    },
    "operator": {
      "type": "PATTERN",
      "value": "[+\\-*%&|^!~<>=,#_$?@]"
    },
    "call": {
      "type": "PREC_LEFT",
      "value": 2,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "FIELD",
            "name": "function",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "identifier"
                },
                {
                  "type": "SYMBOL",
                  "name": "dotted_name"
                }
              ]
            }
          },
          {
            "type": "STRING",
            "value": "["
          },
          {
            "type": "FIELD",
            "name": "arguments",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SEQ",
                  "members": [
                    {
                      "type": "SYMBOL",
                      "name": "_expression"
                    },
                    {
                      "type": "REPEAT",
                      "content": {
                        "type": "SEQ",
                        "members": [
                          {
                            "type": "STRING",
                            "value": ";"
                          },
                          {
                            "type": "SYMBOL",
                            "name": "_expression"
                          }
                        ]
                      }
                    }
                  ]
                },
                {
                  "type": "BLANK"
                }
              ]
            }
          },
          {
            "type": "STRING",
            "value": "]"
          }
        ]
      }
    },
    "parenthesized": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "SYMBOL",
