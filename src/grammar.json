        },
        {
          "type": "FIELD",
          "name": "from",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "from"
              },
              {
                "type": "SYMBOL",
                "name": "_expression"
              }
            ]
          }
        }
      ]
    },
    "delete_statement": {
      "type": "SEQ",
      "members": [
        {
